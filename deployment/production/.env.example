# ============================================================
# LocalIoTCloud Production Environment Configuration
# ============================================================

APP_ENV=production
DEBUG=false
LOCAL_IOT_VERSION=1.0.0

# ------------------------------------------------------------
# MySQL Configuration (Required - Passwords must be specified)
# ------------------------------------------------------------
MYSQL_DATABASE=localiotcloud
MYSQL_USER=localiot
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Application database connection
DB_HOST=mysql
DB_PORT=3306
DB_NAME=localiotcloud
DB_USER=localiot
DB_PASSWORD=

# ------------------------------------------------------------
# Redis Cache & Queue
# ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# InfluxDB Telemetry Time-Series
# ------------------------------------------------------------
INFLUX_URL=http://influxdb:8086
INFLUX_TOKEN=
INFLUX_ORG=localiotcloud
INFLUX_BUCKET=telemetry

# ------------------------------------------------------------
# MQTT Broker (TLS Enabled)
# ------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USERNAME=localiot-backend
MQTT_PASSWORD=
MQTT_TLS_ENABLED=true
MQTT_CA_CERT=/app/certs/localiot-ca.crt

# ------------------------------------------------------------
# Authentication & Cryptographic Secrets (Must be generated)
# ------------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REFRESH_TOKEN_PEPPER=
DEVICE_CREDENTIAL_PEPPER=
CHANNEL_API_KEY_PEPPER=
WEBHOOK_ENCRYPTION_KEY=

# ------------------------------------------------------------
# API & Logging
# ------------------------------------------------------------
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
