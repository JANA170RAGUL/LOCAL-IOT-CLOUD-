# =============================================================================
# LocalIoTCloud Backend – Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in your real values.
# This file IS safe to commit to source control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="LocalIoTCloud"
APP_ENV=development                    # development | staging | production
DEBUG=true
SECRET_KEY=                            # Long random string (e.g. openssl rand -hex 32)
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=localiotcloud
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# InfluxDB (Time-Series / Telemetry)
# ---------------------------------------------------------------------------
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=localiotcloud
INFLUX_BUCKET=telemetry

# ---------------------------------------------------------------------------
# JWT / Authentication & Sessions
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=                        # Separate secret from APP SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_PEPPER=                  # Secret pepper for refresh session HMAC hashing
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_RESET_EXPIRE_MINUTES=30
ACTIVATION_TOKEN_EXPIRE_HOURS=24
DEVICE_CREDENTIAL_PEPPER=              # Secret pepper for device HMAC key hashing
CHANNEL_API_KEY_PEPPER=                # Secret pepper for channel HMAC key hashing
WEBHOOK_ENCRYPTION_KEY=                # Fernet key for webhook secret encryption


# ---------------------------------------------------------------------------
# MQTT Broker Configuration
# ---------------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=localiotcloud
MQTT_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG                        # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log

